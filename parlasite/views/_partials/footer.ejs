</div>

<footer class="footer">
  <div class="container">
    <!-- <div class="row">
      <div class="col-md-12">
        <%# fetchCard('/misc/newsletter-signup-banner/', mandateId, { segment: newsletterSegmentId, no_card_data: true }); %>
      </div>
    </div> -->
    <div class="row border_top">
      <div class="col-12 col-sm-6 col-md-4 footer-col">
        <div class="footer-block">
          <div class="lead"><%- i18n("footer.description") %></div>
        </div>
        <div class="footer-block">
          <div><a href="https://parlameter.org/sl/" target="_blank"><%= i18n("footer.about") %></a></div>
          <div><a href="/<%= sm.landing.legal %>"><%= i18n("footer.legal") %></a></div>
          <div><a href="https://danesjenovdan.si/impact4values/" target="_blank"><%= i18n("footer.financial_support") %></a></div>
        </div>
        <div class="footer-block">
          <div><a href="mailto:<%= i18n("footer.contact_mail") %>" target="_blank" rel="noopener noreferrer"><%= i18n("footer.contact_mail") %></a></div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-md-4 footer-col">
        <div class="footer-block">
          <div class="support-box">
            <div class="text">
              <div class="title"><%= i18n("footer.support_our_work") %></div>
              <div class="desc"><%= i18n("footer.select_donation") %></div>
            </div>
            <div class="buttons">
              <%
                const query = {
                  referrer: `${request.protocol}://${request.hostname}${request.originalUrl}`,
                  utm_source: request.hostname,
                  utm_medium: 'website',
                  utm_campaign: 'parlameter-footer',
                };
                const donateOptions = [
                  { amount: 11, label: '11 €' },
                  { amount: 24, label: '24 €' },
                  { amount: null, label: i18n("footer.donation_custom") },
                  { amount: null, label: i18n("footer.donation_monthly"), monthly: true },
                ];
                donateOptions.forEach(option => {
                  const url = new URL('https://moj.djnd.si/danes-je-nov-dan/doniraj');
                  if (option.amount) {
                    url.pathname += '/info';
                    url.searchParams.set('znesek', option.amount);
                  }
                  if (option.monthly) {
                    url.searchParams.set('mesecna', 'true');
                  }
                  url.searchParams.append('referrer', query.referrer);
                  url.searchParams.append('utm_source', query.utm_source);
                  url.searchParams.append('utm_medium', query.utm_medium);
                  url.searchParams.append('utm_campaign', query.utm_campaign);
                  url.searchParams.append('utm_content', option.label);
                  option.url = url.toString();
                });
              %>
              <% for (const option of donateOptions) { %>
                <a href="<%= option.url %>" target="_blank" rel="noopener noreferrer">
                  <span><%= option.label %></span>
                </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-md-4 footer-col">
        <div class="footer-block">
          <div class="lead semi-bold"><%= i18n("footer.newsletter_title") %></div>
          <form class="newsletter-form">
            <div class="form-group">
              <label>
                <span><%= i18n("footer.newsletter_email_label") %></span>
                <input type="email" id="newsletter-email" required>
              </label>
            </div>
            <div class="form-group">
              <button class="submit-button"><%= i18n("footer.newsletter_subscribe") %></button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <div class="stripeelbottom"></div>
</footer>

<script src="<%- config.urls.cdn %>/js/js.js?v=20260821"></script>
</body>

</html>
