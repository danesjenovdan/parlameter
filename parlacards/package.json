{
  "name": "parlanode",
  "version": "0.0.0",
  "author": "Danes je nov dan",
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "dev": "vite --config build/vite.config.dev.js --port 3001",
    "build": "npm run build:client && npm run build:server && npm run build:locales",
    "build:client": "vite build --config build/vite.config.build.js --ssrManifest --outDir dist/client",
    "build:server": "SSR=1 vite build --config build/vite.config.build.js --ssr --outDir dist/server",
    "build:locales": "node build/build-locales.js",
    "start": "node --import ./instrument.js server/index.js",
    "start:watch": "nodemon -e js,cjs,mjs,vue,html --import ./instrument.js server/index.js",
    "lint": "npm run lint:eslint && npm run lint:component-names && npm run lint:unused-components",
    "lint:eslint": "eslint .",
    "lint:component-names": "node build/lint-component-names.js",
    "lint:unused-components": "node build/lint-unused-components.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@rollup/plugin-virtual": "^3.0.2",
    "@rollup/plugin-yaml": "^5.0.0",
    "@sentry/node": "^10.69.0",
    "@sentry/vue": "^10.69.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/server-renderer": "^3.5.40",
    "axios": "^1.19.0",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "fastify": "^5.11.2",
    "fs-extra": "^11.4.0",
    "html-safe-json": "^2.0.3",
    "lodash-es": "^4.18.1",
    "recaptcha-v3": "^1.11.3",
    "remarkable": "^2.0.1",
    "sass": "^1.102.0",
    "vite": "^8.2.0",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/d3": "^7.4.3",
    "@types/lodash-es": "^4.17.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "glob": "^13.0.6",
    "globals": "^17.9.0",
    "js-yaml": "^5.2.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "vue-eslint-parser": "^10.4.1"
  }
}
